{
  "name": "glue",
  "displayName": "Glue",
  "description": "Glue language support",
  "publisher": "guywaldman",
  "version": "1.12.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/guywaldman/glue"
  },
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:glue",
    "onStartupFinished"
  ],
  "icon": "./icon.png",
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "glue",
        "extensions": [
          ".glue"
        ],
        "icon": {
          "light": "./images/glue-file-icon-light.svg",
          "dark": "./images/glue-file-icon-dark.svg"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "glue",
        "scopeName": "source.glue",
        "path": "./syntaxes/glue.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "glue.restart",
        "title": "Glue: Restart Language Server"
      },
      {
        "command": "glue.showLogs",
        "title": "Glue: Show Language Server Logs"
      }
    ]
  },
  "scripts": {
    "clean": "rimraf out lsp lsp.exe",
    "compile": "tsc -p .",
    "build:lsp": "cargo build -p lsp --release --manifest-path ../glue/Cargo.toml",
    "postbuild:lsp": "cp ../glue/target/release/lsp out/lsp && chmod +x out/lsp",
    "watch": "tsc -p . -w",
    "lint": "echo \"(add lint script)\"",
    "pretest": "npm run compile && npm run build:lsp",
    "test": "node ./out/test/runTest.js",
    "package": "npm run compile && npm run build:lsp && vsce package",
    "publish": "npm run compile && npm run build:lsp && vsce publish"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.0"
  },
  "private": true,
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.0",
    "@types/vscode": "1.125.0",
    "@vscode/vsce": "^3.9.2",
    "@vscode/test-electron": "^3.0.0",
    "glob": "^13.0.6",
    "mocha": "^11.7.6",
    "typescript": "^6.0.3"
  }
}
